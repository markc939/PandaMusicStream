{
  "expo": {
    "name": "Panda Music Streamer",
    "slug": "panda-music-streamer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/panda-logo.png",
    "scheme": "pandamusicstreamer",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/panda-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pandamusic.streamer",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-secure-store",
      "expo-router",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0918d626-4b67-4323-8633-e4bad323b587"
      }
    }
  }
}
